      "RequestApproval(ApprovalRequest) -> save-request > await-decision > has-decision",
      "ApplyApprovalDecision() -> read-request > still-pending > return-request",
      "ExpireApprovalRequest() -> read-request > still-pending > return-request"
    ],
    "events": [
      "ApprovalDecided"
    ],
    "screens": [
      "ApprovalRequests /approvals",
      "ApprovalDecisions /approvals/decisions"
    ]
  },
