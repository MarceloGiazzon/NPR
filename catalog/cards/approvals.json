{
  "id": "approvals",
  "version": "3.0.0",
  "trust": "verified",
  "need": "Request and decide approvals",
  "provides": {
    "concepts": [
      "ApprovalRequest(title, status:PENDING|APPROVED|REJECTED|EXPIRED)",
      "ApprovalDecision(status, completedBy)"
    ],
