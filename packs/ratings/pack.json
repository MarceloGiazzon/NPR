{
  "dslVersion": "3.0.0",
  "pack": "ratings",
  "version": "1.0.1",
  "namespace": "com.example.ratings",
  "description": "Reusable 1-to-5 star ratings with an optional comment, owner-scoped access, and full read visibility for managers.",
  "category": "other",
  "concepts": [
    {
      "name": "Rating",
      "ui": {
        "label": "Rating"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "targetId",
          "type": "string",
          "required": true,
          "ui": {
            "label": "Rated Item"
          }
        },
        {
          "name": "targetType",
          "type": "string",
          "ui": {
            "label": "Item Type"
          }
        },
        {
          "name": "authorAccount",
          "type": "string",
          "required": true,
          "ui": {
            "label": "Author"
          }
        },
        {
          "name": "stars",
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 5,
          "ui": {
            "label": "Stars"
          }
        },
        {
          "name": "comment",
          "type": "string",
          "maxLength": 2000,
          "ui": {
            "label": "Comment"
          }
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "defaultExpression": "now()",
          "ui": {
            "label": "Created At"
          }
        }
      ],
      "access": {
        "read": "authorAccount == $user.id || $user.roles.contains('Manager') || $user.isSystem",
        "write": "authorAccount == $user.id || $user.isSystem"
      }
    }
  ],
  "queries": [
    {
      "name": "AllRatings",
      "concept": "Rating",
      "orderBy": [
        "createdAt"
      ]
    },
    {
      "name": "RatingsOfAuthor",
      "concept": "Rating",
      "where": "authorAccount == $params.author",
      "orderBy": [
        "createdAt"
      ],
      "parameters": [
        {
          "name": "author",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "RatingsForTarget",
      "concept": "Rating",
      "where": "targetId == $params.targetId",
      "orderBy": [
        "createdAt"
      ],
      "parameters": [
        {
          "name": "targetId",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
